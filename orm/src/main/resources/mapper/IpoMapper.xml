<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fund.modules.ipo.mapper.IpoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.fund.modules.ipo.model.Ipo">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="country" property="country" />
        <result column="symbol" property="symbol" />
        <result column="open_date" property="openDate" />
        <result column="close_date" property="closeDate" />
        <result column="listing_date" property="listingDate" />
        <result column="price" property="price" />
        <result column="count" property="count" />
        <result column="exchange" property="exchange" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, country, symbol, open_date, close_date, listing_date, price, count, exchange, status, create_time
    </sql>

</mapper>
