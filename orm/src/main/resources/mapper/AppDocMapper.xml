<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fund.modules.doc.mapper.AppDocMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.fund.modules.doc.model.AppDoc">
        <id column="id" property="id" />
        <result column="used_for" property="usedFor" />
        <result column="i18n_code" property="i18nCode" />
        <result column="title" property="title" />
        <result column="content" property="content" />
        <result column="source_uri" property="sourceUri" />
        <result column="sort_by" property="sortBy" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, used_for, i18n_code, title, content, source_uri, sort_by, create_by, create_time, update_by, update_time
    </sql>

</mapper>
